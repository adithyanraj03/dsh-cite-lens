{
  "name": "dsh-cite-lens",
  "version": "0.3.1",
  "description": "Cite Lens for dsh: select text in a PDF in the Files tab to quote or ask about it in the current chat, and turn the model's [main.pdf p.7 \"exact words\"] citations into links that open the PDF and highlight the passage; /cite-links makes a chat cite every claim.",
  "icon": "assets/icon.png",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE",
    "dsh.plugin.json",
    "screenshots.json",
    "assets/icon.png"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": []
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.5-rc.2"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "pdf",
    "citations",
    "latex",
    "research",
    "papers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adithyanraj03/dsh-cite-lens.git"
  },
  "homepage": "https://adithyanraj03.github.io/dsh-cite-lens/",
  "bugs": {
    "url": "https://github.com/adithyanraj03/dsh-cite-lens/issues"
  },
  "author": "Adithya N Raj (adithyanraj03)",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.4.299"
  }
}
